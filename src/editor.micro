# Pulpo's look for micro: the Linear Dark colors of the viewer (see theme.rs).

color-link default "#E3E4E7,#101012"
color-link comment "italic #585A5C"
color-link identifier "#FCC581"
color-link identifier.class "#55CDFF"
color-link identifier.macro "#58EBDD"
color-link identifier.var "#8FA4FF"
color-link constant "#94A8FF"
color-link constant.bool "#94A8FF"
color-link constant.number "#94A8FF"
color-link constant.string "#F1ADE0"
color-link constant.string.char "#F1ADE0"
color-link constant.specialChar "#58EBDD"
color-link statement "#58EBDD"
color-link preproc "#58EBDD"
color-link type "#55CDFF"
color-link type.keyword "#58EBDD"
color-link special "#58EBDD"
color-link symbol "#D4D4D4"
color-link symbol.operator "#D4D4D4"
color-link symbol.brackets "#D4D4D4"
color-link symbol.tag "#58EBDD"
color-link underlined "underline #8FA4FF"
color-link error "#EB5757"
color-link todo "bold #FCC581"

color-link line-number "#595A5C,#101012"
color-link current-line-number "#E3E4E7,#16171A"
color-link cursor-line "#16171A"
color-link color-column "#16171A"
color-link selection "#E3E4E7,#272B4B"
color-link hlsearch "#E3E4E7,#5E4C37"
color-link match-brace "#FFFFFF,#272B4B"
color-link statusline "#E3E4E7,#1E2025"
color-link statusline.inactive "#97979A,#16171A"
color-link statusline.suggestions "#E3E4E7,#1E2025"
color-link tabbar "#97979A,#16171A"
color-link tabbar.active "#FFFFFF,#5E6AD2"
color-link indent-char "#232429"
color-link divider "#232429,#101012"
color-link scrollbar "#595A5C"
color-link message "#97979A"
color-link error-message "#EB5757"
color-link gutter-error "#EB5757"
color-link gutter-warning "#FCC581"
color-link diff-added "#4CB782"
color-link diff-modified "#8FA4FF"
color-link diff-deleted "#EB5757"
