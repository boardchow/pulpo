#!/bin/sh
# curl -fsSL https://pulpo.sh/install | sh
set -eu

URL="https://github.com/boardchow/pulpo/releases/latest/download/pulpo-macos"

say() { printf '\033[1;38;2;143;164;255m›\033[0m %s\n' "$1"; }
fail() { printf '\033[1;31m✗\033[0m %s\n' "$1" >&2; exit 1; }

# Everything runs from here, so a download cut short runs nothing.
main() {
  [ "$(uname -s)" = "Darwin" ] || fail "Pulpo is made for macOS. Elsewhere, build it from source: https://pulpo.sh/docs/installation#from-source"

  dir="$HOME/.local/bin"
  # An install from before stays where it is, so its server upgrades to the new one.
  cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
  [ -x "$cargo_bin/pulpo" ] && dir="$cargo_bin"

  say "Downloading Pulpo…"
  mkdir -p "$dir"
  tmp="$dir/.pulpo-$$"
  curl -fsSL -o "$tmp" "$URL" || { rm -f "$tmp"; fail "Could not download Pulpo from $URL"; }
  chmod +x "$tmp"
  # A rename: overwriting a running Pulpo in place gets it killed on macOS.
  mv -f "$tmp" "$dir/pulpo"

  say "Adding Pulpo's hooks to your agents…"
  "$dir/pulpo" hooks install

  say "Pulpo is installed in $dir."
  if [ "$(command -v pulpo)" = "$dir/pulpo" ]; then
    say "Run: pulpo"
  else
    say "Add it to your PATH, then open a new terminal and run pulpo:"
    printf '  echo '\''export PATH="%s:$PATH"'\'' >> ~/.zshrc\n' "$dir"
  fi
}

main "$@"
